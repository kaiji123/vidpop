# --- Option A (recommended): Firebase AI Logic -----------------------------
# Create a Firebase project, enable "AI Logic" with the Gemini Developer API,
# register a Web app and paste its config here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# --- Option B (local dev only): raw Gemini API key -------------------------
# Used only when Firebase is not configured. The key ships to the browser,
# so never deploy with this set.
VITE_GEMINI_API_KEY=

# Cloud model used for verification (Search grounding) and extraction fallback.
VITE_GEMINI_MODEL=gemini-3.6-flash

# --- Optional: Google Fact Check Tools API (claims:search) -----------------
# Adds published fact-checks with publisher + review dates to Verify results.
VITE_FACTCHECK_API_KEY=
